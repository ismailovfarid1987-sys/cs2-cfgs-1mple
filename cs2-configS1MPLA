// Параметры запуска (прописать в Steam): -freq 360 -novid -console +fps_max 0

// Настройки мыши и чувствительности
sensitivity 3.09
zoom_sensitivity_ratio 1.00

// Прицел s1mple (Код для настроек: CSGO-3wUf2-ww3TH-UpeGX-s5RjT-fxwPB)
cl_crosshairalpha 255
cl_crosshaircolor 5
cl_crosshaircolor_b 255
cl_crosshaircolor_g 255
cl_crosshaircolor_r 0
cl_crosshairdot 0
cl_crosshairgap -3
cl_crosshairsize 2
cl_crosshairstyle 4
cl_crosshairthickness 1
cl_crosshair_drawoutline 0

// Настройки расположения рук (Viewmodel)
viewmodel_fov 68
viewmodel_offset_x 2.5
viewmodel_offset_y 0
viewmodel_offset_z -1.5

// Бинд на прыжок колесиком мыши (вверх и вниз) + пробел
bind "mwheelup" "+jump"
bind "mwheeldown" "+jump"
bind "space" "+jump"

host_writeconfig
